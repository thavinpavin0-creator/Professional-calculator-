* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  background: #e8e8e8;
  font-family: Arial, sans-serif;
}

.calculator {
  width: 360px;
  max-width: 95%;
  padding: 20px;
  border-radius: 28px;
  background: #181818;
  box-shadow: 0 15px 40px rgba(0,0,0,.25);
}

.top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15px;
}

.app-name {
  color: white;
  font-size: 24px;
  font-weight: bold;
}

.top button {
  width: 42px;
  height: 42px;
  border: 0;
  border-radius: 50%;
  margin-left: 5px;
  cursor: pointer;
}

.display {
  height: 120px;
  padding: 15px;
  margin-bottom: 15px;
  border-radius: 18px;
  background: #101010;
  color: white;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  text-align: right;
  overflow: hidden;
}

#historyPreview {
  color: #888;
  font-size: 15px;
  min-height: 22px;
}

#display {
  font-size: 42px;
  font-weight: bold;
  overflow-x: auto;
  white-space: nowrap;
}

.buttons {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10px;
}

.buttons button {
  height: 65px;
  border: 0;
  border-radius: 18px;
  font-size: 22px;
  font-weight: bold;
  cursor: pointer;
  background: #303030;
  color: white;
}

.buttons button:active {
  transform: scale(.95);
}

.function {
  background: #555 !important;
}

.operator {
  background: #444 !important;
}

.equals {
  background: #ff9500 !important;
}

.zero {
  grid-column: span 2;
}

.footer {
  text-align: center;
  color: #777;
  margin-top: 15px;
  font-size: 12px;
}

.hidden {
  display: none;
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: white;
}

.history-header button {
  border: 0;
  border-radius: 10px;
  padding: 10px;
  cursor: pointer;
}

.history-item {
  display: flex;
  justify-content: space-between;
  padding: 15px 5px;
  border-bottom: 1px solid #333;
  color: white;
}

.history-expression {
  color: #aaa;
}

.history-result {
  color: #20a8ff;
  font-weight: bold;
}

.back {
  width: 100%;
  margin-top: 20px;
  padding: 14px;
  border: 0;
  border-radius: 12px;
  cursor: pointer;
}

/* Light mode */

body.light {
  background: #f2f2f2;
}

body.light .calculator {
  background: white;
}

body.light .app-name,
body.light .history-header {
  color: #111;
}

body.light .display {
  background: #eeeeee;
  color: #111;
}

body.light .buttons button {
  background: #ddd;
  color: #111;
}

body.light .function,
body.light .operator {
  background: #bbb !important;
}

body.light .history-item {
  color: #111;
  border-color: #ddd;
}

body.light .history-expression {
  color: #777;
}

@media (max-width: 400px) {
  .calculator {
    padding: 15px;
  }

  .buttons button {
    height: 60px;
  }
}
